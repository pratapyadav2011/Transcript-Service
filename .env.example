GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Transcription: gemini | whisper | whisper_gemini_fallback
TRANSCRIPTION_ENGINE=whisper
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=3
# Peak RAM scales with batch size; multi-hour audio can OOM-kill the worker.
# Keep modest, raise only if the box has headroom.
WHISPER_BATCH_SIZE=2
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=en
WHISPER_MODEL_DIR=/models/whisper
# Optional vocabulary hint, e.g. Pensacola, CivicClerk, council member names
WHISPER_INITIAL_PROMPT=

# Give up on a task after this many broker deliveries. task_acks_late means a
# worker killed mid-task (e.g. OOM SIGKILL on very long audio) has its message
# redelivered and the job restarts; without a cap a deterministic crash loops
# forever. 2 tolerates one benign worker loss (deploy/restart) before failing.
MAX_TASK_DELIVERIES=2
# Recycle a worker child once its RSS exceeds this many MB (0 = disabled). Guards
# against gradual leaks across tasks; does NOT stop a single task from OOMing.
WORKER_MAX_MEMORY_MB=0
# Hard RAM cap / soft reservation for the whisper-worker container (docker compose).
# Size to the host; an over-long transcription is then killed cleanly and the
# delivery cap above fails the job instead of thrashing the host.
WHISPER_MEM_LIMIT=5g
WHISPER_MEM_RESERVATION=3g

REDIS_URL=redis://localhost:6379/0
MONGODB_URI=mongodb+srv://user:pass@host/dbname?retryWrites=true&w=majority

UPLOAD_DIR=uploads
LOG_DIR=logs

# Optional: explicit binary paths (auto-detected if not set)
YTDLP_PATH=
FFMPEG_PATH=

# Optional: HTTP/SOCKS proxy for yt-dlp (subtitles + audio) and the YouTube
# transcript API. Set when a CDN, Vimeo or YouTube blocks the server's IP.
MEDIA_PROXY_URL=
# Optional: home residential proxy via Cloudflare Tunnel (home-proxy/README.md).
# Starts the cf-proxy service; then set
#   MEDIA_PROXY_URL=http://<proxy-user>:<proxy-pass>@cf-proxy:8888
COMPOSE_PROFILES=
CF_PROXY_HOSTNAME=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=


# Optional: Netscape-format cookies.txt from a browser logged in to YouTube,
# for the "Sign in to confirm you're not a bot" wall. Normally you do NOT need
# to set this — upload the file in the UI ("YouTube cookies" card on Generate
# Transcript) and it is stored at UPLOAD_DIR/youtube-cookies.txt. Set this only
# to point at a different file; it then takes precedence over the UI upload and
# the UI can no longer replace it.
YTDLP_COOKIES_FILE=

# ── Auth (no login) ───────────────────────────────────────────────────────────
# One shared secret for the whole service: the same value as API_SERVICE_TOKEN
# in the website's env. Used three ways:
#   • X-API-Key header on /api/...          (website → job submission)
#   • Authorization: Bearer on /models/...  (website → toxicity scoring)
#   • signing the UI login links ?token=... (see README → "Securing the service")
# Required: docker compose refuses to start without it. The toxicity scorer
# needs at least 32 characters. Generate one with:  openssl rand -hex 32
API_SERVICE_TOKEN=
# The API always needs credentials once API_SERVICE_TOKEN is set. This only
# controls the UI pages: false = UI open to anyone (its buttons still work via
# a session cookie the page hands out), true = UI needs your website's login link.
AUTH_ENABLED=false

# ── HTTPS (docker-compose.caddy.yml) ─────────────────────────────────────────
# Needs a DNS A record pointing at this VM. Caddy gets and auto-renews the
# certificate. On it, /models/... and /health go to the toxicity scorer and
# everything else to the transcript app (which also stays on http://<VM-IP>:8000).
DOMAIN=api.opgov.news

# ── Comment toxicity scorer (toxicity/README.md) ─────────────────────────────
# Authenticates with API_SERVICE_TOKEN (above).
# Whole CPUs for the scorer container (integer; also sets torch threads).
TOXICITY_CPUS=2
# Days each check (including the comment text) is kept for the /toxicity page.
TOXICITY_HISTORY_DAYS=7
