GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Transcription: gemini | whisper | whisper_gemini_fallback
TRANSCRIPTION_ENGINE=whisper
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=3
# Peak RAM scales with batch size; multi-hour audio can OOM-kill the worker.
# Keep modest, raise only if the box has headroom.
WHISPER_BATCH_SIZE=2
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=en
WHISPER_MODEL_DIR=/models/whisper
# Optional vocabulary hint, e.g. Pensacola, CivicClerk, council member names
WHISPER_INITIAL_PROMPT=

# Give up on a task after this many broker deliveries. task_acks_late means a
# worker killed mid-task (e.g. OOM SIGKILL on very long audio) has its message
# redelivered and the job restarts; without a cap a deterministic crash loops
# forever. 2 tolerates one benign worker loss (deploy/restart) before failing.
MAX_TASK_DELIVERIES=2
# Recycle a worker child once its RSS exceeds this many MB (0 = disabled). Guards
# against gradual leaks across tasks; does NOT stop a single task from OOMing.
WORKER_MAX_MEMORY_MB=0
# Hard RAM cap / soft reservation for the whisper-worker container (docker compose).
# Size to the host; an over-long transcription is then killed cleanly and the
# delivery cap above fails the job instead of thrashing the host.
WHISPER_MEM_LIMIT=5g
WHISPER_MEM_RESERVATION=3g

REDIS_URL=redis://localhost:6379/0
MONGODB_URI=mongodb+srv://user:pass@host/dbname?retryWrites=true&w=majority

UPLOAD_DIR=uploads
LOG_DIR=logs

# Optional: explicit binary paths (auto-detected if not set)
YTDLP_PATH=
FFMPEG_PATH=

# Optional: HTTP/SOCKS proxy for yt-dlp (subtitles + audio). Set when a CDN or
# YouTube blocks the server's IP.
MEDIA_PROXY_URL=

# Optional: Netscape-format cookies.txt from a browser logged in to YouTube.
# Required for YouTube ("Sign in to confirm you're not a bot"). Point at a file
# on a mounted volume, e.g. /app/uploads/youtube-cookies.txt
YTDLP_COOKIES_FILE=/app/uploads/youtube-cookies.txt

# ── Auth (no login) ───────────────────────────────────────────────────────────
# Set false to open the UI/API without credentials (local/trusted use only).
AUTH_ENABLED=false
# Shared secret that locks down the whole service. Used two ways:
#   • server-to-server: send it in the  X-API-Key  header
#   • browser UI: your website mints a short-lived signed token from it
#     (see README → "Securing the service") and links users in with ?token=...
# Generate a strong one with:  openssl rand -hex 32
# If left BLANK, auth is disabled (open) — fine for local dev, never in prod.
TRANSCRIPT_SECRET_KEY=f50a81030cee86e3a67286ee6cc99593a2f6fcb36ba15ee45c1e026a62ffb8gh
