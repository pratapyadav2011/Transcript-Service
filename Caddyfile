# Caddy auto-provisions a Let's Encrypt HTTPS certificate for your domain
# and reverse-proxies to the web container. Set DOMAIN in .env.
{$DOMAIN} {
    # Toxicity scorer (toxicity/README.md). Only these two paths reach it; the
    # transcript app's own health check is /api/health, so there's no clash.
    @toxicity path /health /models/unitary/unbiased-toxic-roberta
    handle @toxicity {
        request_body {
            max_size 1MB
        }
        reverse_proxy toxicity:8000
    }

    handle {
        request_body {
            max_size 2GB
        }
        reverse_proxy web:8000
    }
}
