# Caddy gets and auto-renews a Let's Encrypt HTTPS certificate for DOMAIN
# (e.g. api.opgov.news) and reverse-proxies to the containers. DOMAIN needs a
# DNS A record pointing at this VM, and ports 80 and 443 must be reachable from
# the internet. Set DOMAIN in .env.
{$DOMAIN} {
    # Toxicity scorer (toxicity/README.md). Only these two paths reach it; the
    # transcript app's own health check is /api/health, so there's no clash.
    @toxicity path /health /models/unitary/unbiased-toxic-roberta
    handle @toxicity {
        request_body {
            max_size 1MB
        }
        reverse_proxy toxicity:8000
    }

    # Everything else: the transcript app (UI, API, /toxicity history page).
    handle {
        request_body {
            max_size 2GB
        }
        reverse_proxy web:8000
    }
}
